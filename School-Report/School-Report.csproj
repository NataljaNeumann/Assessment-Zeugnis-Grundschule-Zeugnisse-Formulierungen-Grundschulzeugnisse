RCE_CODE_ZZ\$(ProjectName)\Images\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)css\*.css&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\css\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Forms\*.resx&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Forms\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Forms\*.cs&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Forms\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Readme*.*&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Liesmich*.*&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Properties\*.resx&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Properties\*.cs&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Properties\*.settings&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.snk&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.snk&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.pfx&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.pfx&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.snk&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.snk&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.pfx&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.pfx&quot;&#xD;&#xA;  cd /D &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ&quot;&#xD;&#xA;  tar.exe -cf &quot;..\source_code.tar&quot; *.*&#xD;&#xA;  cd ..&#xD;&#xA;  tar.exe -a -c -f source_code.tar.zip source_code.tar&#xD;&#xA;  del /Q source_code.tar&#xD;&#xA;  cd /D &quot;$(TargetDir)&quot;&#xD;&#xA;  del /F /S /Q ZZ_SOURCE_CODE_ZZ&#xD;&#xA;  rmdir /S /Q ZZ_SOURCE_CODE_ZZ&#xD;&#xA;  del /Q &quot;*.pdb&quot;&#xD;&#xA;  tar.exe -a -c -f ..\..\$(ProjectName)_v$(AssemblyVersion).zip *.*&#xD;&#xA;)" />
  </Target>

</Project>
